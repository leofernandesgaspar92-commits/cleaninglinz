# Leco AGI Team – Konfiguration

# Postgres (dieselbe Instanz wie die Leco-App)
DATABASE_URL=postgres://leco:leco@localhost:5432/leco

# Claude als kognitiver Kern der Agenten.
# NICHT gesetzt  -> Simulationsmodus (läuft sofort, echte DB-/Kommunikations-Effekte)
# gesetzt        -> LIVE-Modus (echte KI-Analyse via claude-opus-4-8)
# ANTHROPIC_API_KEY=sk-ant-...

# Auto-Freigabe der Verbesserungsschleife.
# false (Standard) -> jede Änderung braucht menschliche Freigabe.
# true             -> nachweislich sichere Vorschläge (nur Doku/Notiz-Dateien auf
#                     der Allowlist) werden automatisch genehmigt und ausgeführt.
#                     Echter Quellcode, Budget, Übernahmen, Strategie: IMMER Mensch.
AGI_AUTOAPPROVE=false

# Optionaler projektweiter Testbefehl, der nach jeder ausgeführten Änderung über
# Erfolg/Rollback entscheidet (zusätzlich zum automatischen Syntax-Check).
# Beispiel: "npm test --prefix backend" oder "npm run build --prefix frontend"
# AGI_VERIFY_CMD=npm run build --prefix frontend

# Dashboard-Port
PORT=4100
