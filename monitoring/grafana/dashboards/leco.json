{
  "uid": "leco-overview",
  "title": "Leco – Betrieb & Geschäft",
  "tags": ["leco"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    { "type": "stat", "title": "Jahresumsatz (EUR)", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyEUR" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "leco_revenue_eur", "datasource": { "type": "prometheus", "uid": "prometheus" } } ] },
    { "type": "stat", "title": "MRR (EUR)", "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyEUR" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "leco_mrr_eur", "datasource": { "type": "prometheus", "uid": "prometheus" } } ] },
    { "type": "stat", "title": "Aktive Verträge", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "leco_active_contracts", "datasource": { "type": "prometheus", "uid": "prometheus" } } ] },
    { "type": "stat", "title": "Pipeline (Übernahmeziele)", "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "leco_companies_pipeline", "datasource": { "type": "prometheus", "uid": "prometheus" } } ] },

    { "type": "timeseries", "title": "HTTP-Anfragen / s", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "req/s", "datasource": { "type": "prometheus", "uid": "prometheus" } } ] },
    { "type": "timeseries", "title": "Antwortzeit p95 (s)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "datasource": { "type": "prometheus", "uid": "prometheus" } } ] },

    { "type": "timeseries", "title": "Aufträge nach Status", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "leco_jobs", "legendFormat": "{{status}}", "datasource": { "type": "prometheus", "uid": "prometheus" } } ] },
    { "type": "stat", "title": "Speicher (RSS)", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "process_resident_memory_bytes", "datasource": { "type": "prometheus", "uid": "prometheus" } } ] },
    { "type": "stat", "title": "Uptime (s)", "gridPos": { "h": 4, "w": 6, "x": 18, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "process_uptime_seconds", "datasource": { "type": "prometheus", "uid": "prometheus" } } ] }
  ]
}
