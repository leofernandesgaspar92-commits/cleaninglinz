# Backend-Konfiguration
PORT=4000
# PostgreSQL – passt zur docker-compose.yml
DATABASE_URL=postgres://leco:leco@localhost:5432/leco

# --- Sicherheit -------------------------------------------------------------
# JWT-Signatur (in Produktion zwingend setzen, langer Zufallswert!)
JWT_SECRET=bitte-langen-zufallswert-setzen
JWT_TTL=8h

# --- Single Sign-On (optional; leer lassen = deaktiviert) -------------------
OAUTH_REDIRECT_BASE=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT=common

# --- Caching (optional; ohne = In-Memory-Fallback) -------------------------
# REDIS_URL=redis://localhost:6379

# --- Benachrichtigungen (optional; ohne = nur In-App-Feed) -----------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# --- DATEV-Export (Buchhaltung) --------------------------------------------
# DATEV_BERATER=12345
# DATEV_MANDANT=1
# DATEV_KONTO_ERLOES=8400
# DATEV_GEGENKONTO=10000

# --- Backup (backend/scripts/backup.sh) ------------------------------------
# BACKUP_DIR=/var/backups/leco
# DOCS_DIR=/var/lib/leco/documents
# BACKUP_KEEP=14
